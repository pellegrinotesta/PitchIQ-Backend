# Copia questo file in .env e compila i valori. Il file .env non va mai messo in git.

# Database MySQL (docker compose espone il container sulla porta 3307)
DB_USERNAME=pitchiq
DB_PASSWORD=imposta_una_password_mysql_sicura
DB_HOST=localhost
DB_PORT=3307
DB_NAME=pitch_iq
ANALYTICS_DB_URL=

# Chiave di firma dei token JWT: almeno 32 caratteri casuali, diversa per ogni ambiente.
# Per generarla: openssl rand -base64 48
JWT_SECRET=imposta_una_chiave_sicura_di_almeno_32_caratteri

CORS_ORIGINS=http://localhost:4200

# Cartella condivisa tra BFF e servizio di analisi (percorso assoluto sulla tua macchina)
TRACKING_UPLOAD_DIR=/percorso/assoluto/PitchIQ-Backend/tracking-data
TRACKING_KEEP_FILES=false
ANALYTICS_WORKERS=1
